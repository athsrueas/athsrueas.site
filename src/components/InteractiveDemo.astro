---
import { site } from "../content/site";
interface Props { demo: { title: string; url: string }; }
const { demo } = Astro.props;
const parsed = demo.url ? new URL(demo.url) : null;
const canEmbed = parsed?.protocol === "https:" && parsed.origin !== new URL(site.url).origin
  && !parsed.username && !parsed.password;
---
{canEmbed && (
  <section class="mt-12 border-t border-rule pt-8" aria-label={demo.title}>
    <p class="text-sm tracking-[0.14em] uppercase text-muted">Try the app</p>
    <h2 class="mt-3 text-3xl">{demo.title}</h2>
    <p class="mt-4"><a href={demo.url} target="_blank" rel="noopener noreferrer">Open demo in a new tab ↗</a></p>
    <iframe class="mt-6 w-full rounded-md border border-rule bg-white" style="height: 640px;"
      title={demo.title} src={demo.url} sandbox="allow-scripts allow-same-origin allow-forms"
      referrerpolicy="no-referrer" loading="lazy" />
  </section>
)}
