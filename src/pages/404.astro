---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="mx-auto max-w-xl px-5 py-24 sm:px-8">
    <p class="text-sm tracking-[0.16em] uppercase text-muted">404</p>
    <h1 class="mt-3 font-display text-4xl">Page not found</h1>
    <p class="mt-4 text-muted">
      That address is not part of this site. Try the home page, writing, or CV.
    </p>
    <p class="mt-8">
      <a href="/" class="underline">Back to home</a>
    </p>
  </main>
</BaseLayout>