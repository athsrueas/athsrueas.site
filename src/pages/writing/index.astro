---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing")).sort((a, b) => a.data.order - b.data.order);

const formatDate = (date: string) =>
  new Date(date + "T00:00:00").toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
---

<BaseLayout
  title="Writing"
  description="Essays and working notes by Thomas Freestone on open knowledge, creative tools, The Graph, and data."
>
  <main class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <p class="text-sm tracking-[0.18em] uppercase text-muted">Essays</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl">Writing</h1>
    <p class="mt-5 max-w-xl leading-7 text-ink-soft">
      Essays and working notes on open knowledge, creative tools, ownership, and The Graph. The project notes connect the ideas to things you can explore or build on.
    </p>
    <ul class="mt-12 divide-y divide-rule border-y border-rule">
      {
        posts.map((post) => (
          <li class="py-8">
            <a href={`/writing/${post.id}/`} class="no-underline">
              <h2 class="font-display text-2xl leading-snug hover:underline">
                {post.data.title}
              </h2>
            </a>
            {post.data.updatedDate ? (
              <p class="mt-2 font-sans text-xs text-muted">Edited {formatDate(post.data.updatedDate)}</p>
            ) : null}
            <p class="mt-3 leading-7 text-ink-soft">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
