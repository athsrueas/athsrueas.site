---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InteractiveDemo from "../../components/InteractiveDemo.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  return (await getCollection("software")).map(project => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { data } = project;
---
<BaseLayout title={data.title} description={data.summary}>
  <main class="mx-auto max-w-5xl px-5 py-14 sm:px-8 sm:py-20">
    <a class="text-sm text-muted" href="/projects/">All projects</a>
    <p class="mt-8 text-sm tracking-[0.14em] uppercase text-muted">{data.status}</p>
    <h1 class="mt-3 font-display text-5xl">{data.title}</h1>
    <p class="mt-6 max-w-3xl text-xl text-muted">{data.summary}</p>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
      {data.stack.map(tag => <li class="rounded border border-rule px-3 py-1 text-sm">{tag}</li>)}
    </ul>
    <div class="mt-6 flex flex-wrap gap-6 text-sm">
      {data.repository && <a href={data.repository} target="_blank" rel="noopener noreferrer">View source</a>}
      {data.website && <a href={data.website} target="_blank" rel="noopener noreferrer">Visit live site</a>}
    </div>
    <div class="mt-10 max-w-3xl whitespace-pre-line text-lg leading-8">{data.description}</div>
    {data.demo.enabled && <InteractiveDemo demo={data.demo} />}
  </main>
</BaseLayout>
