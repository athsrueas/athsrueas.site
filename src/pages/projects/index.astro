---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
const projects = (await getCollection("software")).sort((a, b) =>
  Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title)
);
const gameAssets = projects.filter(project => project.data.category === "game-assets");
const software = projects.filter(project => project.data.category !== "game-assets");
---
<BaseLayout title="Projects" description="Software, experiments, and interactive demos by Thomas Freestone.">
  <main class="site-shell catalog-page">
    <header class="page-intro"><p class="eyebrow">Software & experiments</p><h1>Projects</h1><p>Tools for exploring knowledge and making things. Start with Geo Companion for open data, Way Music for musical experiments, or Folio Studio for a place to publish your own work. Each project explains what works today and what is still taking shape.</p></header>
    {gameAssets.length > 0 && <section aria-labelledby="game-assets-title">
      <h2 id="game-assets-title" class="project-group-title">Game asset tools</h2>
      <div class="project-grid">
        {gameAssets.map(({id, data}) => <ProjectCard href={`/projects/${id}/`} title={data.title} summary={data.summary} status={data.status} stack={data.stack} hasDemo={data.demo.enabled && Boolean(data.demo.url)} />)}
      </div>
    </section>}
    <section class="project-group" aria-labelledby="software-title">
      <h2 id="software-title" class="project-group-title">Software & experiments</h2>
      <div class="project-grid">
        {software.map(({id, data}) => <ProjectCard href={`/projects/${id}/`} title={data.title} summary={data.summary} status={data.status} stack={data.stack} hasDemo={data.demo.enabled && Boolean(data.demo.url)} />)}
        <ProjectCard href="/projects/dephi/" title="deφ" summary="Transparency and accountability in the nonprofit sector." status="Project concept" />
      </div>
    </section>
  </main>
</BaseLayout>
