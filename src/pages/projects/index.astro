---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
const projects = (await getCollection("software")).sort((a, b) =>
  Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title)
);
---
<BaseLayout title="Projects" description="Software, experiments, and interactive demos by Thomas Freestone.">
  <main class="site-shell catalog-page">
    <header class="page-intro"><p class="eyebrow">Software & experiments</p><h1>Projects</h1><p>Tools, ideas, and small experiments. Explore the work and try an app.</p></header>
    <div class="project-grid">
      {projects.map(({id, data}) => <ProjectCard heading="h2" href={`/projects/${id}/`} title={data.title} summary={data.summary} status={data.status} stack={data.stack} hasDemo={data.demo.enabled && Boolean(data.demo.url)} />)}
      <ProjectCard heading="h2" href="/projects/dephi/" title="deφ" summary="Transparency and accountability in the nonprofit sector." status="Project concept" />
    </div>
  </main>
</BaseLayout>
