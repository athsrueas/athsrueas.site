---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../content/site";

const jobs = [
  {
    org: "Performance Services",
    role: "IT Project Manager",
    dates: "2024–Present",
    scope: "Expanded responsibilities since January 2026: Business Intelligence, Digital Transformation and Enterprise Systems.",
    points: [
      "Lead technology and business process improvement projects from requirements and planning through implementation, business acceptance, employee adoption, and evaluation. Coordinate stakeholders, vendors, schedules, budgets, risks, and build-versus-buy decisions.",
      "Analyze departmental workflows and information needs; translate them into business rules, functional requirements, and testable acceptance criteria that reduce duplicate entry and manual handoffs.",
      "Design, build, test, and maintain business applications, including user interfaces, processing logic, and data access. Use AI-assisted development tools while reviewing generated code and validating application behavior.",
      "Develop AI-powered document-processing workflows for utility bills, scans, and business records, covering intake, extraction, field mapping, validation, human review, and export with source traceability and safe retries.",
      "Build APIs, systems integrations, and workflow automation with appropriate authentication, access controls, logging, and exception handling. Support enterprise system conversions, data mapping, reconciliation, and production readiness.",
      "Deploy and support applications on Linux, including services, dependencies, environment configuration, web routing, and reverse proxies. Manage versioned releases, preserve operational files, queues, and databases, and maintain recovery procedures.",
      "Evaluate AI tools for business value, accuracy, reliability, data sensitivity, and cost. Work with subject matter experts and technology owners to apply approved standards, human review, and acceptance testing.",
      "Deliver employee training, individual coaching, videos, and written guides for applications, AI tools, and digital workflows. Maintain user documentation and release notes, address adoption barriers, and evaluate effective use.",
    ],
  },
  {
    org: "Independent",
    role: "Graph Advocate",
    dates: "2022–2024",
    points: [
      "Produce content covering technical cryptographic and data science topics.",
      "Understand and make information accessible to a less technical audience.",
      "Community building for The Graph Advocates DAO and The Graph Foundation.",
      "Participate in the network and provide technical support for less knowledgeable users.",
      "Plan and deliver educational content on our online platforms.",
      "Thought leader for protocol changes and improvements.",
    ],
  },
  {
    org: "Christel House Academy",
    role: "Mathematics Teacher, 7th and 8th grade, Christel House Academy South",
    dates: "2020–2024",
    points: [
      "Active social-emotional learning and life skills advisor for a cohort of students.",
      "Develop material and lessons aligned with or derived from Indiana State Academic standards.",
      "Track student learning growth indicators through assessment and direct intervention strategies when necessary.",
      "Engage in restorative, relationship-based disciplinary practices and building school community culture.",
      "Exceptional and frequent professional development leading to growth in all aspects of the practice.",
      "Leadership in mentoring new math staff.",
    ],
  },
  {
    org: "Christel House Academy",
    role: "IndyTeach Apprentice Teacher in upper secondary mathematics at Watanabe High School",
    dates: "2019–2020",
    points: [
      "Collaborate with a variety of Christel House professionals to earn a Secondary Teaching License.",
      "Teaching Geometry, Precalculus, and Advisory — social-emotional and career preparation — classes.",
      "Hands-on experience in data collection and processing, collaboration with other educators, managing classrooms, research, content development, implementation, and assessment.",
      "Leadership roles in taking over classes from a mentor teacher to gain more hands-on experience.",
    ],
  },
  {
    org: "Christel House Academy",
    role:
      "Math Interventionist for Watanabe High School, RTI framework, Lower House 9th and 10th grade mathematics",
    dates: "2018–2019",
    points: [
      "Worked with the Math department, the Principal, and other administrators to develop and track intervention strategies primarily for the 9th and 10th grade classes.",
      "Assisted in accommodating IEPs and ESL needs.",
      "Offered after-school tutoring for the high school as a whole in all offered levels of mathematics.",
      "Leadership roles in enrichment activities for students including clubs and field experiences.",
    ],
  },
  {
    org: "IUPUI Mathematics Department",
    role: "Math Tutor at the Math Assistance Center, serving students of IUPUI and Ivy Tech",
    dates: "2014–2018",
    points: [
      "Early algebra to advanced courses such as Differential Equations, Multidimensional Math, and Linear Algebra.",
      "Working one-on-one and in groups with students and faculty.",
    ],
  },
];
---

<BaseLayout
  title="CV"
  description="CV of Thomas C Freestone: IT Project Manager working across business intelligence, digital transformation, enterprise systems, and hands-on software development."
>
  <main class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <p class="text-sm tracking-[0.18em] uppercase text-muted">Curriculum Vitae</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl">Thomas C Freestone</h1>
    <p class="mt-4">
      <a href={links.linkedin} class="underline decoration-rule">LinkedIn</a>
    </p>

    <section class="mt-12">
      <h2 class="border-b border-rule pb-2 font-display text-sm tracking-[0.16em] uppercase">
        Summary
      </h2>
      <p class="mt-5 leading-7">
        IT Project Manager at Performance Services, working across business intelligence,
        digital transformation, and enterprise systems. My responsibilities combine project
        delivery and business analysis with hands-on software development, AI-powered
        document processing, systems integration, and Linux deployment and production support.
        My background is in applied mathematics, secondary mathematics education, and
        community building through The Graph. Licensed teacher in Indiana.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="border-b border-rule pb-2 font-display text-sm tracking-[0.16em] uppercase">
        Professional experience
      </h2>
      <ol class="mt-8 space-y-12">
        {
          jobs.map((job) => (
            <li>
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-display text-xl">{job.org}</h3>
                <p class="text-sm text-muted">{job.dates}</p>
              </div>
              <p class="mt-1 text-ink-soft">{job.role}</p>
              {job.scope && <p class="mt-3 text-sm leading-6 text-muted">{job.scope}</p>}
              <ul class="mt-4 list-disc space-y-2 pl-5 text-[1.02rem] leading-7">
                {job.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-14">
      <h2 class="border-b border-rule pb-2 font-display text-sm tracking-[0.16em] uppercase">
        Education
      </h2>
      <div class="mt-8 space-y-8">
        <div>
          <h3 class="font-display text-xl">IUPUI (Purdue University)</h3>
          <p class="mt-1 text-ink-soft">B.S. in Applied Math, minor in Physics · Graduated May 2018</p>
          <ul class="mt-3 list-disc space-y-1 pl-5 leading-7">
            <li>Undergraduate research in medical applications of mathematics</li>
            <li>Extensive studies in Chemistry (20 hrs) and Biology (10 hrs)</li>
          </ul>
        </div>
        <div>
          <h3 class="font-display text-xl">Danville Community High School</h3>
          <p class="mt-1 text-ink-soft">Class of 2013</p>
          <ul class="mt-3 list-disc space-y-1 pl-5 leading-7">
            <li>Honors Core 40 Diploma</li>
            <li>1 year studying abroad at the American School of Barcelona</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mt-14">
      <h2 class="border-b border-rule pb-2 font-display text-sm tracking-[0.16em] uppercase">
        Affiliations and awards
      </h2>
      <ul class="mt-8 space-y-6">
        <li>
          <h3 class="font-display text-xl">Performance Based Bonus, Christel House Supervisor</h3>
          <p class="mt-1 text-sm text-muted">2019–2023</p>
          <p class="mt-2 leading-7">
            Based on going above and beyond, taking on extra responsibilities.
          </p>
        </li>
        <li>
          <h3 class="font-display text-xl">IUPUI Startup Elevator Pitch Award</h3>
          <p class="mt-2 leading-7">
            Cash award by audience vote for investment in our project Aggrobyte. Aggrobyte sought
            to develop an alternative to herbicide for farming using AI-assisted robots that would
            remove weeds from cornfields.
          </p>
        </li>
      </ul>
    </section>
  </main>
</BaseLayout>
